---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description?: string;
    activePath?: string;
    year?: number;
    mainClass?: string;
}

const {
    title,
    description = 'Perencana libur & cuti bersama paling efisien di Indonesia, disinkronkan dengan SKB 3 Menteri.',
    activePath = 'beranda',
    year = new Date().getFullYear(),
    mainClass = '',
} = Astro.props;
---

<html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
        />
    </head>
    <body class="bg-surface font-body-default text-body-default text-on-surface antialiased">
        <Header activePath={activePath} year={year} />
        <main class={`w-full pt-16 ${mainClass}`}>
            <slot />
        </main>
        <Footer year={year} />
    </body>
</html>
