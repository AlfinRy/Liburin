---
import '../styles/global.css';
import { getHolidays } from '../lib/holiday';
import { buildCalendar, topBridges } from '../lib/engine';
import { LeavePlanner } from '../components/react/LeavePlanner';

const year = new Date().getFullYear() === 2026 || new Date() >= new Date(2026, 0, 1) ? 2026 : 2026;
const holidays = await getHolidays(year);
const days = buildCalendar(year, holidays);
const top = topBridges(days, 3);

const fmt = (d: string, opts: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'long' }) =>
    new Intl.DateTimeFormat('id-ID', opts).format(new Date(`${d}T00:00:00`));

const nationals = holidays.filter((h) => !h.isCutiBersama);
const cutiBersama = holidays.filter((h) => h.isCutiBersama);
---

<html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>Liburin — Rencanakan cuti, dapatkan libur terpanjang {year}</title>
        <meta
            name="description"
            content={`Masukkan jatah cutimu dan Liburin merekomendasikan tanggal cuti terbaik untuk libur panjang berturut-turut, berdasarkan kalender resmi SKB 3 Menteri ${year}.`}
        />
    </head>
    <body>
        <header
            class="sticky top-0 z-10 border-b border-separator/60 bg-bg-primary/70 backdrop-blur-xl"
            style="border-color: color-mix(in srgb, var(--separator) 60%, transparent)"
        >
            <div class="mx-auto flex max-w-280 items-center justify-between px-6 py-3 md:px-16">
                <a href="/" class="text-[15px] font-semibold no-underline text-text-primary">
                    Liburin
                </a>
                <a
                    href="#daftar-libur"
                    class="text-[13px] font-medium text-accent no-underline"
                >
                    Daftar libur {year}
                </a>
            </div>
        </header>
        <main class="mx-auto max-w-280 px-6 py-12 md:px-16 md:py-16 flex flex-col gap-16">
            {top[0] && (
                <section class="relative flex flex-col items-center gap-5 py-4 text-center md:py-10">
                    <div class="hero-glow" aria-hidden="true"></div>
                    <h1 class="display-num my-0 text-[56px] font-bold md:text-[80px]">
                        {top[0].streakDays} hari libur
                    </h1>
                    <p class="m-0 max-w-xl text-[15px] text-text-secondary md:text-base">
                        Libur terpanjang {year}: cukup ambil{' '}
                        <strong class="text-text-primary">
                            {top[0].leaveDates.length} hari cuti
                        </strong>{' '}
                        pada{' '}
                        <strong class="text-text-primary">
                            {top[0].leaveDates.map((d) => fmt(d)).join(', ')}
                        </strong>{' '}
                        — libur {fmt(top[0].streakStart)} sampai{' '}
                        {fmt(top[0].streakEnd, { weekday: 'long', day: 'numeric', month: 'long' })}.
                    </p>
                    <a
                        href="#planner"
                        class="mt-2 rounded-full border border-separator px-6 py-2.5 text-sm font-medium text-accent no-underline transition duration-150 ease-apple hover:bg-bg-secondary active:scale-95"
                    >
                        Cari kombinasi cutimu
                    </a>
                    <div
                        class="no-scrollbar -mx-6 mt-10 flex w-full snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-2 text-left sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0"
                    >
                        {top.map((b, i) => (
                            <article
                                class="card w-[80%] max-w-[320px] shrink-0 snap-start sm:w-auto"
                            >
                                <p class="tnum m-0 text-xs font-medium text-text-secondary">
                                    #{i + 1} · {fmt(b.streakStart, { month: 'long' })}
                                </p>
                                <p class="display-num my-2 text-3xl font-bold">
                                    {b.streakDays}
                                    <span class="text-sm font-medium text-text-secondary">
                                        hari libur
                                    </span>
                                </p>
                                <p class="m-0 text-sm text-text-secondary">
                                    Ambil cuti{' '}
                                    <strong class="text-accent">
                                        {b.leaveDates.map((d) => fmt(d)).join(', ')}
                                    </strong>
                                </p>
                                <p class="tnum m-0 mt-1 text-xs text-text-secondary">
                                    {b.leaveDates.length} cuti → {b.streakDays} libur ·{' '}
                                    {b.efficiency.toFixed(1)}× efektif
                                </p>
                            </article>
                        ))}
                    </div>
                </section>
            )}

            <LeavePlanner client:load holidays={holidays} year={year} />

            <section id="daftar-libur" class="flex scroll-mt-16 flex-col gap-6">
                <h2 class="m-0 text-xl font-semibold">
                    Daftar Hari Libur Nasional & Cuti Bersama {year}
                </h2>
                <div class="card overflow-x-auto p-0">
                    <table class="ref-table w-full text-left text-[15px]">
                        <thead>
                            <tr class="border-b border-separator text-xs uppercase tracking-wide text-text-secondary">
                                <th class="px-6 py-4 font-medium">Tanggal</th>
                                <th class="px-6 py-4 font-medium">Nama</th>
                                <th class="px-6 py-4 font-medium">Jenis</th>
                            </tr>
                        </thead>
                        <tbody>
                            {holidays.map((h) => (
                                <tr class="border-b border-separator last:border-0">
                                    <td class="tnum whitespace-nowrap px-6 py-3">
                                        {fmt(h.date, { weekday: 'short', day: 'numeric', month: 'long' })}
                                    </td>
                                    <td class="px-6 py-3">{h.name}</td>
                                    <td class="px-6 py-3">
                                        <span
                                            class="rounded-full px-3 py-1 text-xs font-medium"
                                            style={`background: color-mix(in srgb, ${
                                                h.isCutiBersama ? 'var(--success)' : 'var(--warning)'
                                            } 14%, transparent); color: ${
                                                h.isCutiBersama ? 'var(--success)' : 'var(--warning)'
                                            }`}
                                        >
                                            {h.isCutiBersama ? 'Cuti Bersama' : 'Libur Nasional'}
                                        </span>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
                <p class="m-0 text-xs text-text-secondary">
                    Sumber: SKB 3 Menteri tentang Hari Libur Nasional dan Cuti Bersama Tahun {year} ({nationals.length} hari libur nasional, {cutiBersama.length} cuti bersama). Cuti bersama bersifat anjuran — kebijakan dapat berbeda di tiap perusahaan.
                </p>
            </section>
        </main>
        <footer class="border-t border-separator">
            <div
                class="mx-auto flex max-w-280 flex-col items-center gap-2 px-6 py-8 text-center text-xs text-text-secondary md:px-16"
            >
                <p class="m-0">
                    Liburin · Data:{' '}
                    <a
                        href="https://www.kemenkopmk.go.id/sites/default/files/pengumuman/2025-09/SKB%20Libur%20Nasional%20dan%20Cuti%20Bersama%20Tahun%202026.pdf"
                        target="_blank"
                        rel="noopener"
                        class="text-accent"
                    >
                        SKB 3 Menteri {year}
                    </a>
                </p>
                <p class="m-0">Cuti bersama bersifat anjuran — kebijakan tiap perusahaan dapat berbeda.</p>
            </div>
        </footer>
    </body>
</html>
