---
import BaseLayout from '../layouts/BaseLayout.astro';

const year = Number(Astro.url.searchParams.get('year')) || new Date().getFullYear();
---

<BaseLayout title="Liburin - Perencana Libur & Cuti Bersama" activePath="beranda" year={year}>
    <div class="max-w-6xl mx-auto px-margin py-space-xl">
        <h1 class="font-headline-1 text-headline-1 text-on-surface tracking-tight">
            Liburin {year}
        </h1>
        <p class="font-body-large text-body-large text-on-surface-variant mt-space-sm">
            Halaman beranda sedang dibangun.
        </p>
    </div>
</BaseLayout>
