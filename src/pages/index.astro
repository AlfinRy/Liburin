---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHolidays } from '../lib/holiday';
import { resolveYear } from '../lib/year';
import { buildCalendar, findBridges, topBridges } from '../lib/engine';
import HeroSection from '../components/beranda/HeroSection.astro';
import StatsSection from '../components/beranda/StatsSection.astro';
import RecommendationPreview from '../components/beranda/RecommendationPreview.astro';
import CalculatorSection from '../components/beranda/CalculatorSection.astro';
import HowItWorks from '../components/beranda/HowItWorks.astro';

const year = resolveYear(Astro.url.searchParams.get('year'));
const holidays = await getHolidays(year);
const days = buildCalendar(year, holidays);
const top = topBridges(days, 3);
const total = findBridges(days).filter((b) => b.streakDays >= 3)
    .map((b) => `${b._startIndex}-${b._endIndex}`)
    .filter((v, i, a) => a.indexOf(v) === i).length;
---

<BaseLayout
    title={`Liburin - Perencana Libur & Cuti Bersama ${year}`}
    activePath="beranda"
    year={year}
>
    {top[0] && <HeroSection bridge={top[0]} days={days} year={year} />}
    <StatsSection holidays={holidays} days={days} />
    <RecommendationPreview bridges={top} total={total} />
    <CalculatorSection year={year} maxQuota={20} holidays={holidays} />
    <HowItWorks />
</BaseLayout>
