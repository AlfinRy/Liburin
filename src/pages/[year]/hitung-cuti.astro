---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHolidays } from '../../lib/holiday';
import { AVAILABLE_YEARS, resolveYear } from '../../lib/year';
import { buildCalendar, topBridges } from '../../lib/engine';
import SimulatorSection from '../../components/hitung-cuti/SimulatorSection.astro';
import LongWeekendSection from '../../components/hitung-cuti/LongWeekendSection.astro';

export function getStaticPaths() {
    return AVAILABLE_YEARS.map((y) => ({ params: { year: String(y) } }));
}

const year = resolveYear(Astro.params.year);
const holidays = await getHolidays(year);
const days = buildCalendar(year, holidays);
const top = topBridges(days, 3, null);
---

<BaseLayout
    title={`Hitung Cuti ${year} - Liburin`}
    activePath="hitung-cuti"
    year={year}
    mainClass="bg-surface"
>
    <div class="flex flex-col w-full">
        <SimulatorSection year={year} holidays={holidays} />
        <div class="max-w-4xl mx-auto w-full px-margin" data-longweekend-wrap>
            <LongWeekendSection bridges={top} days={days} />
        </div>
    </div>
</BaseLayout>

<script>
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(new Date());
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-longweekend]'));
    const fresh = cards.filter((c) => (c.dataset.end ?? '') >= today);
    cards
        .filter((c) => !fresh.includes(c))
        .forEach((c) => c.remove());
    if (cards.length > 0 && fresh.length === 0) {
        document.querySelector('[data-longweekend-wrap]')?.remove();
    }
</script>
