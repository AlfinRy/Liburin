---
import { AVAILABLE_YEARS, resolveYear } from '../../../lib/year';
import RekomendasiPage from '../../../components/pages/RekomendasiPage.astro';

export function getStaticPaths() {
    return AVAILABLE_YEARS.flatMap((y) =>
        Array.from({ length: 20 }, (_, i) => ({
            params: { year: String(y), quota: String(i + 1) },
        }))
    );
}

const year = resolveYear(Astro.params.year);
const quota = Math.min(20, Math.max(1, Number(Astro.params.quota) || 5));
---

<RekomendasiPage year={year} quota={quota} />
