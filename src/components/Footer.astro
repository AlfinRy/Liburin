---
interface Props {
    year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;

const links = [
    { label: 'Beranda', href: `/?year=${year}` },
    { label: 'Hitung Cuti', href: `/hitung-cuti?year=${year}` },
    { label: 'Rekomendasi', href: `/rekomendasi?year=${year}` },
    { label: 'Kalender', href: `/kalender-tahunan?year=${year}` },
];
---

<footer class="w-full bg-surface-container-low mt-space-xl border-t border-surface-container-high">
    <div class="max-w-7xl mx-auto px-margin py-space-xl">
        <div
            class="flex flex-col md:flex-row items-center justify-between gap-space-md text-center md:text-left"
        >
            <div class="space-y-space-xs">
                <div class="flex items-center justify-center md:justify-start gap-space-xs">
                    <div
                        class="h-5 w-5 rounded-md bg-primary text-on-primary flex items-center justify-center"
                    >
                        <span class="material-symbols-outlined text-[13px]">event_available</span>
                    </div>
                    <span class="font-headline-3 text-headline-3 text-on-surface">Liburin</span>
                </div>
                <p
                    class="font-footnote text-footnote text-on-surface-variant max-w-xl"
                >
                    Data diselaraskan dengan Surat Keputusan Bersama (SKB) 3 Menteri (Menag,
                    Menaker, MenPAN-RB) tentang Hari Libur Nasional dan Cuti Bersama Republik
                    Indonesia.
                </p>
            </div>
            <div class="flex flex-col items-center md:items-end gap-space-xs">
                <div class="flex items-center gap-space-md">
                    {
                        links.map((l) => (
                            <a
                                class="font-footnote text-footnote text-on-surface-variant hover:text-on-surface transition-colors"
                                href={l.href}
                            >
                                {l.label}
                            </a>
                        ))
                    }
                </div>
                <span class="font-caption-2 text-caption-2 text-on-surface-variant">
                    © {year} Liburin. Dirancang dengan presisi HIG untuk efisiensi cuti Indonesia.
                </span>
            </div>
        </div>
    </div>
</footer>
