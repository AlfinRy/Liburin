---
import { yearHref } from '../lib/year';

interface Props {
    year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;

const links = [
    { label: 'Beranda', href: yearHref(year) },
    { label: 'Hitung Cuti', href: yearHref(year, 'hitung-cuti') },
    { label: 'Rekomendasi', href: yearHref(year, 'rekomendasi') },
    { label: 'Kalender', href: yearHref(year, 'kalender-tahunan') },
];
---

<footer class="w-full bg-surface-container-low mt-space-xl border-t border-surface-container-high">
    <div class="max-w-7xl mx-auto px-margin py-space-xl">
        <div
            class="flex flex-col md:flex-row items-center justify-between gap-space-md text-center md:text-left"
        >
            <div class="space-y-space-xs">
                <div class="flex items-center justify-center md:justify-start gap-space-sm">
                    <img
                        src="/liburin-wordmark-light.png"
                        alt="Liburin"
                        class="h-7 w-auto object-contain logo-lightmode"
                        width="110"
                        height="40"
                    />
                    <img
                        src="/liburin-wordmark-dark.png"
                        alt="Liburin"
                        class="h-7 w-auto object-contain logo-darkmode"
                        width="110"
                        height="40"
                    />
                </div>
                <p
                    class="font-footnote text-footnote text-on-surface-variant max-w-xl"
                >
                    Data resmi mengikuti SKB 3 Menteri: Hari Libur Nasional & Cuti Bersama.
                </p>
            </div>
            <div class="flex flex-col items-center md:items-end gap-space-xs">
                <div class="flex items-center gap-space-md">
                    {
                        links.map((l) => (
                            <a
                                class="font-footnote text-footnote text-on-surface-variant hover:text-on-surface transition-colors"
                                href={l.href}
                            >
                                {l.label}
                            </a>
                        ))
                    }
                </div>
                <span class="font-caption-2 text-caption-2 text-on-surface-variant">
                    © {year} Liburin
                </span>
            </div>
        </div>
    </div>
</footer>
