---
interface Props {
    year: number;
}

const { year } = Astro.props;
---

<div class="bg-surface-container-low rounded-xl p-space-lg flex flex-col md:flex-row items-center justify-between gap-space-lg shadow-sm">
    <div class="space-y-space-xs max-w-xl">
        <span class="font-caption-2 text-caption-2 uppercase tracking-wider text-on-surface-variant font-bold">
            Inspirasi Perjalanan Liburin
        </span>
        <h3 class="font-headline-2 text-headline-2 text-on-surface font-semibold">
            Rencanakan libur panjangmu lebih awal, bukan mendadak
        </h3>
        <p class="font-body-default text-body-default text-on-surface-variant">
            Dengan mengamankan tanggal cuti rekomendasi di atas, Anda memiliki cukup waktu untuk
            memburu tiket transportasi dan penginapan jauh sebelum harga naik di periode ramai.
        </p>
    </div>
    <div class="w-full md:w-80 h-44 rounded-xl overflow-hidden shadow-sm shrink-0 relative bg-surface-container-high flex items-center justify-center">
        <span class="material-symbols-outlined text-[48px] text-on-surface-variant">landscape</span>
        <div class="absolute bottom-2 right-2 px-2.5 py-1 rounded-full bg-surface/80 backdrop-blur-md text-on-surface font-caption-2 text-caption-2 font-medium">
            Indonesia • {year}
        </div>
    </div>
</div>

<div class="bg-surface-container-highest/80 backdrop-blur-md rounded-xl p-space-md flex flex-col sm:flex-row items-center justify-between gap-space-md shadow-sm">
    <div class="flex items-center gap-space-sm">
        <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-on-primary shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[20px]">sync</span>
        </div>
        <div class="space-y-0.5">
            <p class="font-callout text-callout font-semibold text-on-surface">
                Sinkronkan Rekomendasi Terpilih
            </p>
            <p class="font-footnote text-footnote text-on-surface-variant">
                Dukung ekspor ke Apple Calendar (.ics), Google Calendar, atau kirim ke HRIS perusahaan.
            </p>
        </div>
    </div>
    <div class="flex items-center gap-2 w-full sm:w-auto shrink-0">
        <button class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full bg-surface-container-lowest text-on-surface hover:bg-surface transition-colors font-callout text-callout font-medium shadow-sm cursor-pointer" type="button" data-export="ics">
            <span class="material-symbols-outlined text-[16px]">file_download</span>
            <span>Unduh .ICS</span>
        </button>
        <button class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-full bg-primary text-on-primary hover:bg-primary/95 transition-all font-callout text-callout font-semibold shadow-sm cursor-pointer" type="button" data-export="gcal">
            <span class="material-symbols-outlined text-[16px]">calendar_add_on</span>
            <span>Google Calendar</span>
        </button>
    </div>
</div>

<div class="fixed bottom-6 left-1/2 -translate-x-1/2 px-5 py-3 rounded-full bg-inverse-surface text-inverse-on-surface font-caption-1 text-caption-1 font-medium shadow-xl opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-2 z-50" id="toast">
    <span class="material-symbols-outlined text-[16px] text-secondary-fixed">check_circle</span>
    <span id="toast-message">Tersimpan ke rencana kalender.</span>
</div>
