---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHolidays } from '../../lib/holiday';
import { buildCalendar, findBridges, recommend } from '../../lib/engine';
import { getYearlyImage, imageQueriesForBridge } from '../../lib/unsplash';
import OverviewSection from '../rekomendasi/OverviewSection.astro';
import RecommendationCard from '../rekomendasi/RecommendationCard.astro';
import SyncSection from '../rekomendasi/SyncSection.astro';

interface Props {
    year: number;
    quota: number;
}

const { year, quota } = Astro.props;

const holidays = await getHolidays(year);
const days = buildCalendar(year, holidays);
const bridges = findBridges(days);
const recommendation = recommend(bridges, quota, null);
const images = await Promise.all(
    recommendation.bridges.map((b) => {
        const queries = [...new Set(imageQueriesForBridge(b, days))];
        return Promise.all(queries.map((q, i) => getYearlyImage(q, year, i)));
    })
);

const total = bridges
    .filter((b) => b.streakDays >= 3)
    .map((b) => `${b._startIndex}-${b._endIndex}`)
    .filter((v, i, a) => a.indexOf(v) === i).length;
---

<BaseLayout
    title={`Rekomendasi Cuti ${year} - Liburin`}
    activePath="rekomendasi"
    year={year}
    mainClass="bg-surface"
>
    <div class="flex flex-col w-full">
        <OverviewSection year={year} quota={quota} total={total} recommendation={recommendation} />
        <div class="max-w-7xl mx-auto w-full px-margin space-y-space-md" id="cards-stack">
            {recommendation.bridges.map((b, i) => (
                <RecommendationCard bridge={b} days={days} quota={quota} featured={i === 0} images={images[i]} />
            ))}
        </div>
        <div class="max-w-7xl mx-auto w-full px-margin mt-space-xl space-y-space-md">
            <SyncSection year={year} />
        </div>
    </div>
</BaseLayout>

<script>
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(new Date());
    const allCards = Array.from(document.querySelectorAll<HTMLElement>('.recommendation-card'));
    const freshCards = allCards.filter((card) => (card.dataset.end ?? '') >= today);
    allCards.filter((card) => !freshCards.includes(card)).forEach((card) => card.remove());

    if (freshCards.length !== allCards.length) {
        const gained = freshCards.reduce((sum, c) => sum + Number(c.dataset.streak ?? 0), 0);
        const used = freshCards.reduce((sum, c) => sum + Number(c.dataset.leave ?? 0), 0);
        const bonus = Math.max(0, gained - used);
        const pct = Math.min(96, Math.round((used / Math.max(gained, 1)) * 100));
        const countEl = document.querySelector('[data-stat-count]');
        const gainedEl = document.querySelector('[data-stat-gained]');
        const usedEl = document.querySelector('[data-stat-used]');
        const bonusEl = document.querySelector('[data-stat-bonus]');
        const barTaken = document.querySelector<HTMLElement>('[data-stat-bar-taken]');
        const barBonus = document.querySelector<HTMLElement>('[data-stat-bar-bonus]');
        if (countEl) countEl.textContent = String(freshCards.length);
        if (gainedEl) gainedEl.textContent = `${gained} Hari (+${Math.round((gained / Math.max(used, 1) - 1) * 100)}%)`;
        if (usedEl) usedEl.textContent = `${used} Hari Diambil`;
        if (bonusEl) bonusEl.textContent = `${bonus} Hari Bridge & Weekend`;
        if (barTaken) barTaken.style.width = `${pct}%`;
        if (barBonus) barBonus.style.width = `${100 - pct}%`;
    }

    const filterPills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.recommendation-card');

    filterPills.forEach((pill) => {
        pill.addEventListener('click', () => {
            filterPills.forEach((p) => {
                p.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm', 'font-semibold');
                p.classList.add('bg-surface-container-low', 'text-on-surface-variant');
            });
            pill.classList.remove('bg-surface-container-low', 'text-on-surface-variant');
            pill.classList.add('bg-primary', 'text-on-primary', 'shadow-sm', 'font-semibold');

            const filterVal = pill.getAttribute('data-filter');
            cards.forEach((card) => {
                const cat = card.getAttribute('data-category') ?? '';
                const el = card as HTMLElement;
                el.style.display = filterVal === 'all' || cat.includes(filterVal!) ? '' : 'none';
            });
        });
    });

    function showToast(msg: string) {
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-message');
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none');
        toast.classList.add('opacity-100');
        setTimeout(() => {
            toast.classList.remove('opacity-100');
            toast.classList.add('opacity-0', 'pointer-events-none');
        }, 2800);
    }

    document.querySelectorAll('[data-share-plan]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const detail = (btn as HTMLElement).dataset.detail ?? '';
            const title = 'Rekomendasi Cuti Liburin';
            if (navigator.share) {
                navigator
                    .share({
                        title: `Rekomendasi Cuti Liburin: ${title}`,
                        text: `Cek trik cuti hemat: ${detail} di Liburin!`,
                        url: window.location.href,
                    })
                    .catch(() => {});
            } else {
                navigator.clipboard.writeText(`${title} - ${detail}. ${window.location.href}`);
                showToast('Rencana cuti disalin ke clipboard!');
            }
        });
    });

    document.querySelectorAll('[data-export]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const type = (btn as HTMLElement).dataset.export;
            showToast(
                type === 'gcal'
                    ? 'Menghubungkan Google Calendar…'
                    : 'Berkas .ics berhasil diunduh.'
            );
        });
    });
</script>
