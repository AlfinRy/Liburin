---
interface Props {
    activePath?: 'beranda' | 'hitung-cuti' | 'rekomendasi' | 'kalender-tahunan';
    year?: number;
}

const { activePath = 'beranda', year = new Date().getFullYear() } = Astro.props;

const navItems: Array<{ path: string; label: string; href: string }> = [
    { path: 'beranda', label: 'Beranda', href: `/?year=${year}` },
    { path: 'hitung-cuti', label: 'Hitung Cuti', href: `/hitung-cuti?year=${year}` },
    { path: 'rekomendasi', label: 'Rekomendasi', href: `/rekomendasi?year=${year}` },
    { path: 'kalender-tahunan', label: 'Kalender Tahunan', href: `/kalender-tahunan?year=${year}` },
];

const currentYear = new Date().getFullYear();
const yearOptions = [currentYear - 1, currentYear];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface border-b border-surface-container-high">
    <div class="h-16 max-w-6xl mx-auto px-6 flex items-center justify-between gap-space-md">
        <a href={navItems[0].href} class="flex items-center gap-2.5 no-underline text-inherit">
            <div class="h-7 w-7 rounded-lg bg-primary text-on-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-[18px]">event_available</span>
            </div>
            <span class="font-headline-3 text-headline-3 text-on-surface font-bold tracking-tight">
                Liburin
            </span>
            <span class="hidden sm:inline font-caption-1 text-caption-1 text-on-surface-variant tabular-nums">
                {year}
            </span>
        </a>

        <nav class="hidden lg:flex items-center gap-1">
            {
                navItems.map((item) =>
                    item.path === activePath ? (
                        <a
                            aria-current="page"
                            class="px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface font-semibold font-callout text-callout no-underline"
                            href={item.href}
                        >
                            {item.label}
                        </a>
                    ) : (
                        <a
                            class="px-3 py-1.5 rounded-lg font-callout text-callout text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors no-underline"
                            href={item.href}
                        >
                            {item.label}
                        </a>
                    )
                )
            }
        </nav>

        <div class="flex items-center gap-space-sm">
            <div class="flex items-center p-0.5 rounded-lg bg-surface-container-low border border-surface-container-high">
                {
                    yearOptions.map((y) => (
                        <a
                            href={`?year=${y}`}
                            class:list={[
                                'px-2.5 py-1 rounded-md font-caption-1 text-caption-1 font-semibold tabular-nums transition-colors no-underline',
                                y === year
                                    ? 'bg-surface-container-lowest text-on-surface shadow-xs'
                                    : 'text-on-surface-variant hover:text-on-surface',
                            ]}
                        >
                            {y}
                        </a>
                    ))
                }
            </div>

            <button
                aria-label="Beralih mode tema"
                class="w-8 h-8 rounded-lg flex items-center justify-center text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors cursor-pointer"
                type="button"
                data-theme-toggle
            >
                <span class="material-symbols-outlined text-[20px]">dark_mode</span>
            </button>
        </div>
    </div>
</header>
