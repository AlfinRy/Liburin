---
import type { Bridge } from '../../lib/types';
import { idDate } from '../../lib/format';

interface Props {
    bridges: Bridge[];
    total: number;
}

const { bridges, total } = Astro.props;
if (!bridges.length) return;

const cards = bridges.slice(0, 3);
---

<section class="w-full pb-space-xl">
    <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between mb-space-md gap-space-xs">
            <h2 class="font-headline-2 text-headline-2 font-bold text-on-surface m-0">
                Rekomendasi cuti {new Date(`${cards[0].streakStart}T00:00:00`).getFullYear()}
            </h2>
            <a class="font-callout text-callout font-semibold text-primary hover:opacity-80 transition-opacity no-underline" href="/rekomendasi">
                Semua {total} rekomendasi
            </a>
        </div>
        <div class="divide-y divide-surface-container-high border-y border-surface-container-high">
            {
                cards.map((b) => (
                    <div class="py-space-md flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
                        <div>
                            <p class="font-footnote text-footnote text-on-surface-variant m-0 tabular-nums">
                                {idDate(b.streakStart, { day: 'numeric', month: 'short' })} – {idDate(b.streakEnd, { day: 'numeric', month: 'short' })}
                            </p>
                            <h3 class="font-headline-3 text-headline-3 font-semibold text-on-surface mt-1 mb-0">
                                {b.leaveDates.length} cuti → {b.streakDays} hari libur
                            </h3>
                            <p class="font-footnote text-footnote text-on-surface-variant mt-1 mb-0 tabular-nums">
                                Ambil {b.leaveDates.map((d) => idDate(d, { day: 'numeric', month: 'short' })).join(', ')}
                            </p>
                        </div>
                        <span class="font-headline-2 text-headline-2 font-bold text-primary tabular-nums shrink-0">
                            {b.efficiency.toFixed(1)}×
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</section>
