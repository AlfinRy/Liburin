---
const steps = [
    {
        title: 'Masukkan sisa cuti',
        desc: 'Sisa cutimu hari ini.',
    },
    {
        title: 'Algoritma cari hari kejepit',
        desc: 'Cuti dijepit di antara libur dan weekend.',
    },
    {
        title: 'Dapat rencana cuti',
        desc: 'Rangkaian libur terpanjang, siap diajukan.',
    },
];
---

<section class="w-full pb-space-xl">
    <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-headline-2 text-headline-2 font-bold text-on-surface m-0 mb-space-md">
            Cara kerjanya
        </h2>
        <ol class="grid grid-cols-1 md:grid-cols-3 gap-space-lg list-none m-0 p-0">
            {
                steps.map((s, i) => (
                <li class="border-t border-surface-container-high pt-space-sm" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
                        <p class="font-caption-1 text-caption-1 text-primary font-bold tabular-nums m-0">{i + 1}</p>
                        <h3 class="font-headline-3 text-headline-3 font-semibold text-on-surface mt-1 mb-1">{s.title}</h3>
                        <p class="font-body-default text-body-default text-on-surface-variant m-0">{s.desc}</p>
                    </li>
                ))
            }
        </ol>
    </div>
</section>
