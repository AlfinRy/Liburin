---
import type { Bridge, DayInfo } from '../../lib/types';
import { idDate, idDay, idWeekday } from '../../lib/format';

interface Props {
    bridge: Bridge;
    days: DayInfo[];
    year: number;
}

const { bridge, days, year } = Astro.props;
const leaveSet = new Set(bridge.leaveDates);
const byDate = new Map(days.map((d) => [d.date, d]));
const streak: DayInfo[] = [];
for (let d = new Date(`${bridge.streakStart}T00:00:00`); d <= new Date(`${bridge.streakEnd}T00:00:00`); d.setDate(d.getDate() + 1)) {
    const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const info = byDate.get(iso);
    if (info) streak.push(info);
}

const grids = [
    'grid grid-cols-3 sm:grid-cols-3',
    'grid grid-cols-4 sm:grid-cols-4',
    'grid grid-cols-3 sm:grid-cols-5',
    'grid grid-cols-4 sm:grid-cols-6',
    'grid grid-cols-5 sm:grid-cols-7',
    'grid grid-cols-6 sm:grid-cols-8',
    'grid grid-cols-4 sm:grid-cols-7 md:grid-cols-9',
    'grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10',
    'grid grid-cols-6 sm:grid-cols-9 md:grid-cols-11',
    'grid grid-cols-7 sm:grid-cols-10 md:grid-cols-12',
];
const grid = grids[Math.min(Math.max(streak.length - 3, 0), grids.length - 1)];

const cellClass = (day: DayInfo) => {
    if (leaveSet.has(day.date)) return 'bg-primary text-on-primary shadow-tint';
    if (day.status === 'libur_nasional') return 'bg-tertiary-fixed/50 text-on-tertiary-fixed-variant';
    if (day.status === 'cuti_bersama') return 'bg-secondary-fixed/50 text-on-secondary-fixed-variant';
    if (day.status === 'weekend') return 'bg-surface-container-high text-on-surface-variant';
    return 'bg-surface-container-high text-on-surface-variant';
};

const label = (day: DayInfo) => {
    if (leaveSet.has(day.date)) return 'Cuti';
    if (day.status === 'libur_nasional') return 'Libur';
    if (day.status === 'cuti_bersama') return 'CB';
    if (day.status === 'weekend') return 'Weekend';
    return 'Kerja';
};
---

<section class="w-full pb-space-lg relative overflow-hidden">
    <!-- Ambient gradient: cahaya lembut di belakang hero -->
    <div class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-[480px]" aria-hidden="true"></div>

    <div class="relative max-w-6xl mx-auto px-6 pt-space-xl md:pt-space-xl">
        <p
            class="font-caption-1 text-caption-1 font-semibold text-primary m-0 mb-space-sm"
            data-reveal
        >
            Peluang terbaik {year}
        </p>
        <h1
            class="font-display-hero text-display-hero-mobile md:text-display-hero text-on-surface font-bold leading-[1.05] tabular-nums m-0"
            data-reveal
            style="--reveal-delay: 60ms"
        >
            {bridge.streakDays} hari libur,
            <br class="hidden sm:block" />
            <span class="text-primary">cuma {bridge.leaveDates.length} hari cuti</span>
        </h1>
        <p
            class="font-body-large text-body-large text-on-surface-variant mt-space-sm tabular-nums m-0"
            data-reveal
            style="--reveal-delay: 120ms"
        >
            {idDate(bridge.streakStart, { day: 'numeric', month: 'short' })} – {idDate(bridge.streakEnd, { day: 'numeric', month: 'short' })} {year} · cuti: {bridge.leaveDates.map((d) => idDate(d, { day: 'numeric', month: 'short' })).join(', ')}
        </p>
        <div class="flex flex-wrap items-center gap-space-sm mt-space-md" data-reveal style="--reveal-delay: 180ms">
            <a
                href={`/${year}/hitung-cuti`}
                class="group px-5 py-2.5 rounded-full bg-primary text-on-primary font-callout text-callout font-semibold hover:bg-primary-container active:scale-[0.97] transition-all no-underline shadow-tint hover:shadow-tint-lg"
            >
                Buka Simulasi Cuti
                <span
                    class="material-symbols-outlined text-[16px] align-middle ml-1 transition-transform duration-200 group-hover:translate-x-0.5"
                    aria-hidden="true">arrow_forward</span
                >
            </a>
            <a
                href={`/${year}/rekomendasi`}
                class="px-5 py-2.5 rounded-full border border-outline-variant text-on-surface font-callout text-callout font-semibold hover:bg-surface-container hover:border-on-surface-variant/50 active:scale-[0.97] transition-all no-underline"
            >
                Lihat Semua Rekomendasi
            </a>
        </div>

        <div
            class="mt-space-xl border border-surface-container-high rounded-2xl bg-surface-container-lowest p-space-md shadow-tint"
            data-reveal
            style="--reveal-delay: 240ms"
        >
            <div class={`gap-1.5 ${grid}`}>
                {
                    streak.map((day, i) => (
                        <div
                            class={`flex flex-col items-center justify-center py-2.5 rounded-xl text-center transition-transform duration-200 hover:-translate-y-0.5 ${cellClass(day)}`}
                            style={`--reveal-delay: ${280 + i * 30}ms`}
                            data-reveal
                        >
                            <span class="font-caption-2 text-caption-2 font-medium opacity-80">{idWeekday(day.date).slice(0, 3)}</span>
                            <span class="font-headline-3 text-headline-3 font-bold tabular-nums">{idDay(day.date)}</span>
                            <span class="font-caption-2 text-caption-2 mt-0.5 font-semibold">{label(day)}</span>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
