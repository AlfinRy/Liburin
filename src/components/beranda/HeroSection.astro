---
import type { Bridge, DayInfo } from '../../lib/types';
import { idDate, idDay, idWeekday } from '../../lib/format';

interface Props {
    bridge: Bridge;
    days: DayInfo[];
    year: number;
}

const { bridge, days, year } = Astro.props;const leaveSet = new Set(bridge.leaveDates);
const byDate = new Map(days.map((d) => [d.date, d]));
const streak: DayInfo[] = [];
for (let d = new Date(`${bridge.streakStart}T00:00:00`); d <= new Date(`${bridge.streakEnd}T00:00:00`); d.setDate(d.getDate() + 1)) {
    const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const info = byDate.get(iso);
    if (info) streak.push(info);
}

const grids = [
    'grid grid-cols-3 sm:grid-cols-3',
    'grid grid-cols-4 sm:grid-cols-4',
    'grid grid-cols-3 sm:grid-cols-5',
    'grid grid-cols-4 sm:grid-cols-6',
    'grid grid-cols-5 sm:grid-cols-7',
    'grid grid-cols-6 sm:grid-cols-8',
    'grid grid-cols-4 sm:grid-cols-7 md:grid-cols-9',
    'grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10',
    'grid grid-cols-6 sm:grid-cols-9 md:grid-cols-11',
    'grid grid-cols-7 sm:grid-cols-10 md:grid-cols-12',
];
const grid = grids[Math.min(Math.max(streak.length - 3, 0), grids.length - 1)];

const cellClass = (day: DayInfo) => {
    if (leaveSet.has(day.date))
        return 'relative flex flex-col items-center justify-center p-2.5 rounded-lg bg-primary text-on-primary text-center shadow-sm';
    if (day.status === 'libur_nasional')
        return 'flex flex-col items-center justify-center p-2.5 rounded-lg bg-tertiary-fixed/40 text-on-tertiary-fixed text-center shadow-xs';
    if (day.status === 'cuti_bersama')
        return 'flex flex-col items-center justify-center p-2.5 rounded-lg bg-secondary-fixed/50 text-on-secondary-fixed-variant text-center shadow-xs';
    if (day.status === 'weekend')
        return 'flex flex-col items-center justify-center p-2.5 rounded-lg bg-surface-container-high text-on-surface-variant text-center';
    return 'flex flex-col items-center justify-center p-2.5 rounded-lg bg-surface-container-high text-on-surface-variant text-center';
};

const label = (day: DayInfo) => {
    if (leaveSet.has(day.date)) return 'Ajukan Cuti';
    if (day.status === 'libur_nasional') return 'Libur Nas';
    if (day.status === 'cuti_bersama') return 'Cuti Bersama';
    if (day.status === 'weekend') return 'Weekend';
    return 'Kerja';
};
---

<section class="relative w-full overflow-hidden pb-space-xl">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[560px] pointer-events-none overflow-hidden">
        <div class="absolute -top-20 left-1/4 w-[540px] h-[360px] bg-gradient-to-br from-primary/15 via-primary-fixed/30 to-transparent blur-3xl rounded-full opacity-70"></div>
        <div class="absolute -top-10 right-1/4 w-[460px] h-[320px] bg-gradient-to-bl from-tertiary-fixed/35 via-secondary-container/20 to-transparent blur-3xl rounded-full opacity-60"></div>
        <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#0059b5 1px, transparent 1px); background-size: 24px 24px;"></div>
    </div>
    <div class="max-w-6xl mx-auto px-margin">
        <div class="flex items-center justify-between pt-space-md pb-space-lg">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-high text-on-surface shadow-sm">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                <span class="font-caption-1 text-caption-1 font-semibold tracking-wide text-on-surface-variant">
                    Sinkron SKB 3 Menteri • Kalender {year} Valid
                </span>
            </div>
            <div class="hidden md:flex items-center gap-space-xs font-footnote text-footnote text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px] text-primary">update</span>
                <span>Dihitung otomatis dari penanggalan resmi</span>
            </div>
        </div>

        <div class="relative w-full rounded-2xl p-space-lg md:p-space-xl overflow-hidden" style="backdrop-filter: blur(20px); background: rgba(255, 255, 255, 0.92); border: 1px solid rgba(255, 255, 255, 0.85); box-shadow: rgba(0, 89, 181, 0.06) 0px 4px 24px -2px, rgba(15, 23, 42, 0.05) 0px 20px 48px -8px;">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-lg">
                <div class="max-w-2xl space-y-space-sm">
                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-fixed/60 text-primary font-caption-1 text-caption-1 font-semibold">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
                        <span>Rekomendasi Terdekat • Efisiensi Tertinggi</span>
                    </div>
                    <h1 class="font-display-hero text-display-hero text-on-surface font-extrabold tracking-tight leading-[1.08] tabular-nums">
                        {bridge.streakDays} hari libur,
                        <br class="hidden sm:inline">
                        <span class="text-primary">cuma butuh {bridge.leaveDates.length} hari cuti</span>
                    </h1>
                    <p class="font-body-large text-body-large text-on-surface-variant">
                        {idDate(bridge.streakStart)} – {idDate(bridge.streakEnd)}
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row lg:flex-col items-start sm:items-center lg:items-end gap-space-sm shrink-0">
                    <a href="/hitung-cuti" class="w-full sm:w-auto px-6 py-3.5 rounded-full bg-primary text-on-primary font-callout text-callout font-semibold shadow-md shadow-primary/20 hover:opacity-95 active:scale-[0.98] transition-all flex items-center justify-center gap-2 no-underline">
                        <span>Buka Simulasi Cuti</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </a>
                    <span class="font-footnote text-footnote text-on-surface-variant tabular-nums">
                        Hemat {bridge.streakDays - bridge.leaveDates.length} hari kuota cuti tahunan
                    </span>
                </div>
            </div>

            <div class="mt-space-lg pt-space-md bg-surface-container-low rounded-xl p-space-md">
                <div class="flex items-center justify-between mb-space-sm">
                    <span class="font-caption-1 text-caption-1 uppercase tracking-wider text-on-surface-variant font-semibold">
                        Rincian Rangkaian Hari Libur
                    </span>
                    <span class="font-caption-2 text-caption-2 text-primary font-semibold tabular-nums">
                        Rasio ROI: {bridge.efficiency.toFixed(1)}x Waktu Luang
                    </span>
                </div>
                <div class={`gap-2 ${grid}`}>
                    {
                        streak.map((day) => (
                            <div class={cellClass(day)}>
                                {leaveSet.has(day.date) && (
                                    <span class="absolute -top-1.5 -right-1 px-1.5 py-0.2 rounded-full bg-secondary-container text-on-secondary-container font-caption-2 text-[9px] font-bold uppercase">
                                        Cuti
                                    </span>
                                )}
                                <span class="font-caption-2 text-caption-2 font-medium opacity-80">{idWeekday(day.date).slice(0,3)}</span>
                                <span class="font-headline-2 text-headline-2 font-bold tabular-nums">{idDay(day.date)}</span>
                                <span class="font-caption-2 text-caption-2 mt-1 font-semibold">{label(day)}</span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
