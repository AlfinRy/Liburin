---
import type { DayInfo, Holiday } from '../../lib/types';
import { findBridges } from '../../lib/engine';

interface Props {
    holidays: Holiday[];
    days: DayInfo[];
}

const { holidays, days } = Astro.props;

const nationals = holidays.filter((h) => !h.isCutiBersama).length;
const cutiBersama = holidays.filter((h) => h.isCutiBersama).length;

let naturalStreaks = 0;
let run = 0;
for (const d of days) {
    if (d.status !== 'kerja') {
        run++;
    } else {
        if (run >= 3) naturalStreaks++;
        run = 0;
    }
}
if (run >= 3) naturalStreaks++;

const golden = findBridges(days).filter((b) => b.streakDays >= 8 && b.leaveDates.length <= 3)
    .map((b) => `${b._startIndex}-${b._endIndex}`)
    .filter((v, i, a) => a.indexOf(v) === i).length;

const stats = [
    { value: nationals + cutiBersama, unit: 'hari', text: 'libur resmi' , detail: `${nationals} libur nasional + ${cutiBersama} cuti bersama` },
    { value: naturalStreaks, unit: 'periode', text: 'long weekend tanpa cuti', detail: '3+ hari beruntun' },
    { value: golden, unit: 'periode', text: 'libur 8+ hari', detail: 'cukup 2–3 hari cuti' },
];
---

<section class="w-full pb-space-xl">
    <div class="max-w-6xl mx-auto px-6">
        <dl class="grid grid-cols-1 sm:grid-cols-3 border-t border-surface-container-high">
            {
                stats.map((s, i) => (
                    <div class="py-space-md sm:px-space-md sm:first:pl-0 sm:border-l sm:first:border-l-0 border-surface-container-high" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
                        <dd class="font-headline-1 text-headline-1 font-bold text-on-surface tabular-nums m-0">
                            {s.value} <span class="font-body-default text-body-default font-medium text-on-surface-variant">{s.unit}</span>
                        </dd>
                        <dt class="font-body-default text-body-default font-semibold text-on-surface mt-1 m-0">{s.text}</dt>
                        <p class="font-footnote text-footnote text-on-surface-variant mt-0.5 mb-0">{s.detail}</p>
                    </div>
                ))
            }
        </dl>
    </div>
</section>
