---
interface Props {
    year: number;
    maxQuota: number;
    holidays: import('../../lib/types').Holiday[];
}

const { year, maxQuota, holidays } = Astro.props;
---

<div id="calculator-data" data-holidays={JSON.stringify(holidays)} data-year={year} hidden></div>

<section class="w-full pb-space-xl">
    <div class="max-w-6xl mx-auto px-6">
        <div class="border border-surface-container-high rounded-xl bg-surface-container-lowest p-space-lg md:p-space-xl">
            <div class="max-w-3xl">
                <h2 class="font-headline-2 text-headline-2 font-bold text-on-surface m-0">
                    Berapa sisa jatah cutimu?
                </h2>
                <p class="font-body-default text-body-default text-on-surface-variant mt-1 mb-0">
                    Geser untuk melihat potensi total hari libur dari jatah cutimu.
                </p>
            </div>
            <div class="mt-space-lg grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center">
                <div class="lg:col-span-7 space-y-space-md">
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label class="font-callout text-callout font-semibold text-on-surface" for="leaveSlider">
                                Sisa jatah cuti
                            </label>
                            <span class="font-headline-3 text-headline-3 font-bold text-primary tabular-nums" id="sliderValueText">
                                6 hari
                            </span>
                        </div>
                        <input class="w-full h-2 bg-surface-container-highest rounded-lg appearance-none cursor-pointer" id="leaveSlider" max={maxQuota} min="1" type="range" value="6" />
                        <div class="flex justify-between text-caption-2 font-caption-2 text-on-surface-variant mt-1.5 tabular-nums">
                            <span>1</span>
                            <span>{maxQuota}</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-space-sm pt-space-xs">
                        <div>
                            <p class="font-caption-2 text-caption-2 text-on-surface-variant m-0">Periode libur yang terkunci</p>
                            <p class="font-headline-3 text-headline-3 font-bold text-on-surface mt-0.5 mb-0 tabular-nums" id="scenarioText">-</p>
                        </div>
                        <div>
                            <p class="font-caption-2 text-caption-2 text-on-surface-variant m-0">Sisa jatah tidak terpakai</p>
                            <p class="font-headline-3 text-headline-3 font-bold text-on-surface mt-0.5 mb-0 tabular-nums" id="spareLeaveText">-</p>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-5 lg:border-l lg:border-surface-container-high lg:pl-space-lg">
                    <p class="font-caption-1 text-caption-1 text-on-surface-variant font-semibold uppercase tracking-wider mt-0">
                        Proyeksi {year}
                    </p>
                    <p class="flex items-baseline gap-2 m-0">
                        <span class="font-display-hero text-display-hero font-bold text-on-surface tabular-nums" id="totalHolidayProjection">-</span>
                        <span class="font-body-large text-body-large text-on-surface-variant">hari bebas</span>
                    </p>
                    <p class="font-footnote text-footnote text-on-surface-variant leading-relaxed mb-0" id="projectionDetail"></p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { buildCalendar, findBridges, recommend } from '../../lib/engine';
    import type { Holiday } from '../../lib/types';

    const el = document.getElementById('calculator-data') as HTMLElement | null;
    const slider = document.getElementById('leaveSlider') as HTMLInputElement | null;
    const sliderText = document.getElementById('sliderValueText');
    const projection = document.getElementById('totalHolidayProjection');
    const spareText = document.getElementById('spareLeaveText');
    const scenarioText = document.getElementById('scenarioText');
    const detailText = document.getElementById('projectionDetail');
    if (!el || !slider || !sliderText || !projection || !spareText || !scenarioText || !detailText) {
        throw new Error('calculator elements missing');
    }

    const holidays: Holiday[] = JSON.parse(el.dataset.holidays ?? '[]');
    const year = Number(el.dataset.year);
    const days = buildCalendar(year, holidays);
    const bridges = findBridges(days);

    const cache = new Map<number, ReturnType<typeof recommend>>();

    function compute(quota: number) {
        if (!cache.has(quota)) {
            cache.set(quota, recommend(bridges, quota));
        }
        return cache.get(quota)!;
    }

    slider.addEventListener('input', () => {
        const val = parseInt(slider.value, 10);
        sliderText!.textContent = `${val} hari`;
        const rec = compute(val);
        projection!.textContent = String(rec.totalStreakDays);
        scenarioText!.textContent = `${rec.bridges.length} periode`;
        spareText!.textContent = `${val - rec.totalLeaveUsed} hari`;
        detailText!.textContent = `Pakai ${rec.totalLeaveUsed} hari cuti untuk ${rec.totalStreakDays} hari bebas kerja beruntun.`;
    });

    slider.dispatchEvent(new Event('input'));
</script>
