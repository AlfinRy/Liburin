---
import type { Holiday } from '../../lib/types';

interface Props {
    year: number;
    holidays: Holiday[];
}

const { year, holidays } = Astro.props;
---

<div id="simulator-data" data-holidays={JSON.stringify(holidays)} data-year={year} hidden></div>

<section class="relative w-full">
    <div class="relative max-w-4xl mx-auto px-6 py-space-xl">
        <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-space-lg">
            <h1 class="font-headline-1 text-headline-1-mobile md:text-headline-1 text-on-surface tracking-tight m-0">
                Berapa jatah cuti tahunanmu?
            </h1>
            <p class="font-body-large text-body-large text-on-surface-variant mt-space-xs mb-0">
                Kombinasi cuti paling efisien untuk {year}.
            </p>
        </div>

        <div class="relative rounded-2xl p-space-lg md:p-space-xl border border-surface-container-high bg-surface-container-lowest">
            <div class="flex flex-col items-center">
                <div class="flex items-center justify-center gap-space-lg w-full max-w-md my-space-xs">
                    <button aria-label="Kurangi cuti" class="w-14 h-14 rounded-full bg-surface-container text-on-surface flex items-center justify-center transition-all duration-150 hover:bg-surface-container-high active:scale-90 select-none shadow-sm focus:outline-none cursor-pointer" id="btn-decrement" type="button">
                        <span class="material-symbols-outlined text-[28px]">remove</span>
                    </button>
                    <div class="flex flex-col items-center justify-center min-w-[150px] select-none">
                        <span class="font-display-hero text-display-hero text-on-surface tracking-tight tabular-nums transition-transform duration-150" id="leave-val">12</span>
                        <span class="font-callout text-callout text-on-surface-variant -mt-1 font-semibold uppercase tracking-wider">Hari Cuti</span>
                    </div>
                    <button aria-label="Tambah cuti" class="w-14 h-14 rounded-full bg-surface-container text-on-surface flex items-center justify-center transition-all duration-150 hover:bg-surface-container-high active:scale-90 select-none shadow-sm focus:outline-none cursor-pointer" id="btn-increment" type="button">
                        <span class="material-symbols-outlined text-[28px]">add</span>
                    </button>
                </div>

                <div class="w-full max-w-sm mt-space-md flex flex-col items-center">
                    <input class="w-full h-2" id="leave-slider" max="20" min="1" step="1" type="range" value="12" />
                    <div class="w-full flex justify-between items-center mt-2 px-1 text-on-surface-variant font-caption-2 text-caption-2">
                        <span>1</span>
                        <span class="font-semibold text-primary">Standar 12</span>
                        <span>20</span>
                    </div>
                </div>

                <div class="w-full pt-space-lg mt-space-md">
                    <div class="text-left mb-space-xs">
                        <span class="font-caption-1 text-caption-1 text-on-surface-variant uppercase tracking-wider font-semibold">
                            Prioritas & Periode Liburan
                        </span>
                    </div>
                    <div class="flex flex-wrap gap-2" id="filter-chips">
                        <button class="chip active px-3.5 py-1.5 rounded-full font-callout text-callout transition-all duration-150 bg-primary-container text-on-primary shadow-sm cursor-pointer" data-chip="semua" type="button">
                            Semua
                        </button>
                        <button class="chip px-3.5 py-1.5 rounded-full font-callout text-callout transition-all duration-150 bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high cursor-pointer" data-chip="sem1" type="button">
                            Jan – Jun
                        </button>
                        <button class="chip px-3.5 py-1.5 rounded-full font-callout text-callout transition-all duration-150 bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high cursor-pointer" data-chip="sem2" type="button">
                            Jul – Des
                        </button>
                        <button class="chip px-3.5 py-1.5 rounded-full font-callout text-callout transition-all duration-150 bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high flex items-center gap-1.5 cursor-pointer" data-chip="wisata" type="button">
                            <span class="material-symbols-outlined text-[16px]">beach_access</span>
                            <span>Wisata</span>
                        </button>
                        <button class="chip px-3.5 py-1.5 rounded-full font-callout text-callout transition-all duration-150 bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high flex items-center gap-1.5 cursor-pointer" data-chip="mudik" type="button">
                            <span class="material-symbols-outlined text-[16px]">home_pin</span>
                            <span>Mudik</span>
                        </button>
                    </div>
                </div>

                <div class="w-full mt-space-lg pt-space-xs">
                    <a class="w-full py-3.5 px-space-lg rounded-full bg-primary text-on-primary font-headline-3 text-headline-3 flex items-center justify-center gap-2 hover:opacity-95 active:scale-[0.99] transition-all duration-150 group no-underline" id="cta-rekomendasi" href={`/rekomendasi?year=${year}&quota=12`}>
                        <span>Cari Rekomendasi</span>
                        <span class="material-symbols-outlined text-[20px] transition-transform duration-200 group-hover:translate-x-1">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="mt-space-lg grid grid-cols-1 md:grid-cols-12 gap-space-md">
            <div class="md:col-span-8 rounded-2xl p-space-md border border-surface-container-high bg-surface-container-lowest flex flex-col justify-between">
                <div class="flex items-start justify-between gap-space-sm mb-space-sm">
                    <h2 class="font-headline-3 text-headline-3 text-on-surface m-0">Potensi libur maksimal</h2>
                    <span class="font-callout text-callout font-bold text-on-surface tabular-nums shrink-0" id="multiplier-badge">-×</span>
                </div>
                <p class="font-body-large text-body-large text-on-surface mb-space-md">
                    Dengan <span class="font-semibold text-primary" id="summary-cuti">12 hari</span> cuti → hingga
                    <span class="font-bold text-on-surface underline decoration-secondary decoration-2 underline-offset-4" id="summary-libur">- hari libur</span> di {year}.
                </p>
                <div class="space-y-space-xs">
                    <div class="flex justify-between items-center font-caption-1 text-caption-1 text-on-surface-variant">
                        <span>Efisiensi penggabungan</span>
                        <span class="font-semibold text-on-surface" id="efficiency-percent">-% Optimal</span>
                    </div>
                    <div class="w-full h-3 bg-surface-container rounded-full overflow-hidden flex">
                        <div class="h-full bg-primary-container transition-all duration-300" id="bar-cuti" style="width: 0%;"></div>
                        <div class="h-full bg-secondary-fixed transition-all duration-300" id="bar-bonus" style="width: 100%;"></div>
                    </div>
                    <div class="flex items-center gap-space-md pt-1 font-caption-2 text-caption-2 text-on-surface-variant">
                        <div class="flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-primary-container"></span>
                            <span>Cutimu</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-secondary-fixed"></span>
                            <span>Bonus libur</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="md:col-span-4 rounded-2xl p-space-md border border-outline-variant bg-surface-container-low flex flex-col justify-between">
                <div>
                    <h3 class="font-headline-3 text-headline-3 text-on-surface m-0 mb-space-xs">Tips perencanaan</h3>
                    <p class="font-body-default text-body-default text-on-surface-variant leading-snug m-0" id="tips-text">
                        Cuti di hari kejepit melipatgandakan liburmu.
                    </p>
                </div>
                <div class="mt-space-md pt-space-xs flex items-center justify-end">
                    <span class="font-caption-1 text-caption-1 font-semibold text-primary tabular-nums" id="tips-badge">Hemat maksimal</span>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { buildCalendar, findBridges, recommend } from '../../lib/engine';
    import type { Holiday } from '../../lib/types';

    const root = document.getElementById('simulator-data') as HTMLElement | null;
    const leaveValEl = document.getElementById('leave-val');
    const leaveSlider = document.getElementById('leave-slider') as HTMLInputElement | null;
    const btnDecrement = document.getElementById('btn-decrement');
    const btnIncrement = document.getElementById('btn-increment');
    const summaryCuti = document.getElementById('summary-cuti');
    const summaryLibur = document.getElementById('summary-libur');
    const multiplierBadge = document.getElementById('multiplier-badge');
    const barCuti = document.getElementById('bar-cuti');
    const barBonus = document.getElementById('bar-bonus');
    const efficiencyPercent = document.getElementById('efficiency-percent');
    const cta = document.getElementById('cta-rekomendasi') as HTMLAnchorElement | null;
    const tipsText = document.getElementById('tips-text');
    const tipsBadge = document.getElementById('tips-badge');

    if (!root || !leaveValEl || !leaveSlider || !btnDecrement || !btnIncrement || !summaryCuti || !summaryLibur || !multiplierBadge || !barCuti || !barBonus || !efficiencyPercent) {
        throw new Error('simulator elements missing');
    }

    const holidays: Holiday[] = JSON.parse(root.dataset.holidays ?? '[]');
    const year = Number(root.dataset.year);
    const days = buildCalendar(year, holidays);
    const bridges = findBridges(days);

    const params = new URLSearchParams(window.location.search);
    let currentLeave = Math.min(20, Math.max(1, parseInt(params.get('quota') ?? '12', 10) || 12));

    const cache = new Map<number, ReturnType<typeof recommend>>();
    function compute(quota: number) {
        if (!cache.has(quota)) cache.set(quota, recommend(bridges, quota));
        return cache.get(quota)!;
    }

    const setFill = (input: HTMLInputElement) => {
        const min = Number(input.min) || 0;
        const max = Number(input.max) || 100;
        const pct = ((Number(input.value) - min) / (max - min)) * 100;
        input.style.setProperty('--range-fill', `${pct}%`);
    };

    function updateUI() {
        setFill(leaveSlider!);
        const stats = compute(currentLeave);
        leaveValEl!.textContent = String(currentLeave);
        leaveSlider!.value = String(currentLeave);
        summaryCuti!.textContent = `${currentLeave} hari`;
        summaryLibur!.textContent = `${stats.totalStreakDays} hari libur`;
        multiplierBadge!.textContent = `${(stats.totalStreakDays / Math.max(stats.totalLeaveUsed, 1)).toFixed(1)}×`;
        efficiencyPercent!.textContent = `${Math.min(95, Math.round((stats.totalStreakDays / Math.max(currentLeave, 1)) * 12))}% Optimal`;

        const cutiShare = Math.round((stats.totalLeaveUsed / (stats.totalStreakDays || 1)) * 100);
        barCuti!.style.width = `${cutiShare}%`;
        barBonus!.style.width = `${Math.max(10, 100 - cutiShare)}%`;

        if (cta) cta.href = `/rekomendasi?year=${year}&quota=${currentLeave}`;

        const best = stats.bridges[0];
        if (best && tipsText && tipsBadge) {
            const bonus = best.streakDays - best.leaveDates.length;
            tipsText.textContent = `${best.leaveDates.length} cuti → ${best.streakDays} hari libur beruntun, ${bonus} hari gratis.`;
            tipsBadge.textContent = `Hemat ${Math.round((bonus / best.streakDays) * 100)}%`;
        }
    }

    btnDecrement!.addEventListener('click', () => {
        if (currentLeave > 1) {
            currentLeave--;
            updateUI();
        }
    });

    btnIncrement!.addEventListener('click', () => {
        if (currentLeave < 20) {
            currentLeave++;
            updateUI();
        }
    });

    leaveSlider!.addEventListener('input', () => {
        currentLeave = parseInt(leaveSlider!.value, 10);
        updateUI();
    });

    const chips = document.querySelectorAll('#filter-chips .chip');
    chips.forEach((chip) => {
        chip.addEventListener('click', () => {
            chips.forEach((c) => {
                c.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm', 'active');
                c.classList.add('bg-surface-container', 'text-on-surface-variant');
            });
            chip.classList.remove('bg-surface-container', 'text-on-surface-variant');
            chip.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm', 'active');
        });
    });

    updateUI();
</script>
